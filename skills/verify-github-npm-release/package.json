    "posttest": "node ../../scripts/stage-package-skill.mjs clean verify-github-npm-release test",
    "prepack": "node ../../scripts/stage-package-skill.mjs stage verify-github-npm-release pack",
    "postpack": "node ../../scripts/stage-package-skill.mjs clean verify-github-npm-release pack"
  },
